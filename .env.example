# Supabase transaction pooler: used by the app at runtime
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct or session connection: used only by drizzle-kit migrate
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
PORT=3000

# Supabase Auth: JWTs are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<ref>.supabase.co
# Public anon key: auth endpoints (/v1/auth/*) call Supabase Auth with it. Google needs the provider enabled in the Supabase dashboard.
SUPABASE_ANON_KEY=
JWT_AUDIENCE=authenticated

# Azure Speech: when unset, recording-assess returns 503 SPEECH_PROVIDER_UNAVAILABLE
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local fixtures only: lets cdn.example.invalid URLs through
ALLOW_PLACEHOLDER_AUDIO=false
ENABLE_CRON=true
