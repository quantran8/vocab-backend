# Supabase transaction pooler: used by the app at runtime
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct or session connection: used only by drizzle-kit migrate
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
PORT=3000

# Supabase Auth: JWTs are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<ref>.supabase.co
# Public anon key: auth endpoints (/v1/auth/*) call Supabase Auth with it. Google needs the provider enabled in the Supabase dashboard.
SUPABASE_ANON_KEY=
JWT_AUDIENCE=authenticated

# Azure Speech: when unset, recording-assess returns 503 SPEECH_PROVIDER_UNAVAILABLE
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Service role key: pnpm db:seed (creates the admin account) and GET/PUT /admin/users.
SUPABASE_SERVICE_ROLE_KEY=
# The only admin account. pnpm db:seed creates it from these (password only when creating it).
# The app reads USERNAME and EMAIL at login: Supabase signs in by email, so USERNAME maps to EMAIL. Without them only the email works.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@vocabflow.local
SEED_ADMIN_PASSWORD=

# Custom words. When ANTHROPIC_API_KEY is unset, generation returns 503 LEXICAL_PROVIDER_UNAVAILABLE.
# claude-haiku-5-5 is about 40x cheaper per token.
ANTHROPIC_API_KEY=
LEXICAL_AI_MODEL=claude-opus-5-5

# ElevenLabs needs a paid plan for commercial use. When unset, words are added without audio; a cron job fills it in later.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Audio is voiced from each meaning's IPA, which needs eleven_v4 (IPA in slashes).
# Extra voices admins may pick for bulk audio: voiceId:Label,voiceId:Label. ELEVENLABS_VOICE_ID stays the default.
ELEVENLABS_VOICE_OPTIONS=

# Cloudflare R2 for generated audio (S3 API token with Object Read & Write on the bucket).
# Snapshots keep the URL forever: R2_PUBLIC_BASE_URL must be a stable https origin (custom domain or r2.dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pronunciation-audio
R2_PUBLIC_BASE_URL=

# Local fixtures only: lets cdn.example.invalid URLs through
ALLOW_PLACEHOLDER_AUDIO=false
ENABLE_CRON=true
# Leaderboard launch gate; LP and Tier work while it is off
RANKING_ENABLED=false
# Freemium launch gate: off gives every learner full access. Turn on once an app build with the paywall is live.
FREEMIUM_ENABLED=false
# Free tier: topics in the scope and new words learned in total
FREE_MAX_TOPICS=3
FREE_MAX_NEW_WORDS=150
# Lets learners redeem codes at POST /v1/me/redeem (admins create them under /admin/redeem-codes)
REDEEM_ENABLED=false
# Free learners see an interstitial ad after every N finished sessions (0 = no ads)
AD_EVERY_SESSIONS=3
APPSTORE_BUNDLE_ID=com.visiongroup.syll
APPSTORE_PRODUCT_IDS=syll.premium.monthly,syll.premium.yearly
# Local only: accept unsigned transactions from Xcode StoreKit testing (Syll.storekit)
APPSTORE_ALLOW_XCODE=false
PLAYSTORE_PACKAGE_NAME=com.syll
PLAYSTORE_PRODUCT_IDS=syll.premium.monthly,syll.premium.yearly
# Play Developer API service account key: the JSON file's content, or base64 of it. Unset: Play purchases answer 503
PLAYSTORE_SERVICE_ACCOUNT_JSON=
# Pub/Sub push auth for Real-time Developer Notifications; no audience refuses every push
PLAYSTORE_PUSH_AUDIENCE=
PLAYSTORE_PUSH_SERVICE_ACCOUNT=
# Comma-separated browser origins allowed cross-origin (e.g. the admin on Vercel). Empty keeps CORS off.
CORS_ORIGINS=
