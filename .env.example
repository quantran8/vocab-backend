# Supabase transaction pooler: used by the app at runtime
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct or session connection: used only by drizzle-kit migrate
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
PORT=3000

# Supabase Auth: JWTs are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<ref>.supabase.co
# Public anon key: auth endpoints (/v1/auth/*) call Supabase Auth with it. Google needs the provider enabled in the Supabase dashboard.
SUPABASE_ANON_KEY=
JWT_AUDIENCE=authenticated

# Azure Speech: when unset, recording-assess returns 503 SPEECH_PROVIDER_UNAVAILABLE
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Service role key: pnpm db:seed (creates the admin account), GET/PUT /admin/users and server-side upload of generated audio. Create the public bucket first; it stores stable URLs, because snapshots are immutable.
SUPABASE_SERVICE_ROLE_KEY=
# The only admin account. pnpm db:seed creates it from these (password only when creating it).
# The app reads USERNAME and EMAIL at login: Supabase signs in by email, so USERNAME maps to EMAIL. Without them only the email works.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@vocabflow.local
SEED_ADMIN_PASSWORD=
SUPABASE_AUDIO_BUCKET=pronunciation-audio

# Custom words. When ANTHROPIC_API_KEY is unset, generation returns 503 LEXICAL_PROVIDER_UNAVAILABLE.
# claude-haiku-5-5 is about 40x cheaper per token.
ANTHROPIC_API_KEY=
LEXICAL_AI_MODEL=claude-opus-5-5

# ElevenLabs needs a paid plan for commercial use. When unset, words are added without audio; a cron job fills it in later.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Local fixtures only: lets cdn.example.invalid URLs through
ALLOW_PLACEHOLDER_AUDIO=false
ENABLE_CRON=true
